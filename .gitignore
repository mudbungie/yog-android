/target
# Gradle's working state and outputs. jniLibs is where `make apk` deposits the
# cargo-ndk build — a generated binary, and the leak gate correctly refuses
# any committed binary (BINARY_ALLOWED matches nothing).
/android/.gradle
/android/build
/android/app/build
/android/app/src/main/jniLibs
/android/local.properties

# Python bytecode: the harness scripts are run, never imported by anything
# shipped, and a .pyc is a binary the disclosure gate refuses on sight.
__pycache__/
