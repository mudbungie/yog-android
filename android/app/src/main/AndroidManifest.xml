<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- LOAD-BEARING (bl-014e): cargo-apk adds this silently, gradle does
         not, and Android reports permissionless DNS as no-address-for-
         hostname — a first-class red herring, not a permission denial. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The enrollment scanner (bl-d815). Dangerous, so the manifest entry
         only makes the runtime request possible: dev.yog.Camera asks, the
         operator answers, and a refusal degrades to the paste field with a
         sentence. `required="false"` because a camera is not what this app
         IS — a device without one enrolls by cable or by paste exactly as
         before, and a required feature would hide the app from it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- The paper tools (bl-f34f, DESIGN §16.1). Both are declarations, not
         asks: ACCESS_NETWORK_STATE is a normal permission the installer
         grants outright, and it is what lets `device` say which kind of
         network this phone is on rather than guessing from a socket.
         POST_NOTIFICATIONS is a runtime grant on API 33+ — declaring it only
         makes the ask possible; dev.yog.Paper raises the dialog when a
         notification is first wanted and the app is in front, and refuses in
         band naming the settings act when it is not held. `device`'s battery
         and storage reads and the clipboard write need no permission at
         all. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The sighted pair (bl-b0a9, DESIGN §16.1 rung 1b). Declarations, not
         asks: dev.yog.Fix raises the dialog when a fix is first wanted and
         this app is in front, and refuses in band naming the settings act when
         it is not held. BOTH are declared because Android 12+ lets the
         operator answer a fine ask with "approximate" — the fix that comes
         back carries its own accuracy and dev.yog.Position states it, so a
         coarse answer is legible rather than refused. ACCESS_BACKGROUND_
         LOCATION is deliberately NOT declared: it is a separate settings trip,
         and while the foot serves foreground-only the fix is honest without
         it. The camera tool needs no new line — CAMERA is declared above for
         the enrollment scanner, and a permission is the app's, not a
         feature's. GPS is a feature this app can do without, so the device
         without one still installs. -->
    <!-- The scheduled fetch (bl-fcc5, DESIGN §17). NOT a boot receiver and
         nothing here receives the broadcast: this is the permission
         JobScheduler REQUIRES before it will accept `setPersisted(true)`, and
         without it `Watch.arm` throws instead of scheduling. Persisted
         because a fetch that quietly stopped at the next reboot until the
         operator happened to open the app is exactly the silent degradation
         this app's design excludes — and a phone that reboots in a pocket is
         the case the whole rung is for. It is a normal permission: the
         installer grants it, no dialog, no runtime ask. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The pocketed foot (bl-8bd0, DESIGN §18). Both are normal permissions
         the installer grants outright: FOREGROUND_SERVICE is the one every
         foreground service has needed since API 28, and API 34 added a second
         one PER TYPE — without the matching line `startForeground` throws
         SecurityException rather than degrading. The TYPE is `specialUse`
         because the platform's own clock rules the alternatives out: Android
         15 stops a `dataSync` service after six hours in any 24 and bars it
         from a BOOT_COMPLETED start, and a foot is meant to be reachable for
         days; `connectedDevice` is uncapped but names a Bluetooth/NFC/USB
         companion and carries a runtime prerequisite this app has no business
         declaring. `specialUse` is the platform's "none of the above" — no
         cap, no prerequisite — and the `<property>` on the service below is
         where its justification is written. That property is reviewed by Play
         and never by the platform; this app is `publish = false` and ships
         through no store, so the sentence is true because it was written to
         be, not because anything checks it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- The mark, as an adaptive icon whose two layers are GENERATED from
         the same walk the in-app mark is drawn from (bl-0b31): no committed
         binary, one source, and a test that pins the assets to it. -->
    <application android:label="@string/app_name"
                 android:icon="@mipmap/ic_launcher"
                 android:roundIcon="@mipmap/ic_launcher"
                 android:theme="@style/Theme.AppCompat.NoActionBar">
        <activity android:name=".MainActivity"
                  android:exported="true"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="orientation|keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name"
                       android:value="yog_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The interface tools (bl-1511). The operator enables it; the app
             never grants itself anything. BIND_ACCESSIBILITY_SERVICE is
             held by the SYSTEM, not requested by us: declaring it here is
             what stops any other app from binding this service. -->
        <service android:name=".InterfaceService"
                 android:exported="true"
                 android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                       android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- The shade read (bl-5cbd, DESIGN §16.1 rung 2). Exported because
             the SYSTEM is what binds a notification listener, and
             BIND_NOTIFICATION_LISTENER_SERVICE is held by the system rather
             than requested by us: declaring it here is what stops any other
             app from binding this service, and the platform refuses to bind a
             listener that does not declare it. There is no permission line up
             top for this one and there cannot be — notification access is not
             a permission an app may ask for, it is an enable the operator
             performs in system settings (or a trusted device performs over the
             debug bridge), which is exactly why this rung answers the read want
             that READ_SMS would otherwise be asked for. -->
        <service android:name=".ShadeService"
                 android:exported="true"
                 android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- The scheduled fetch (bl-fcc5, DESIGN §17). Not exported: only the
             platform's own job scheduler starts it, and BIND_JOB_SERVICE is
             held by the SYSTEM rather than requested by us — declaring it
             here is what stops anything else from binding this service, and
             JobScheduler refuses to schedule a job whose service does not
             declare it. -->
        <service android:name=".Watch"
                 android:exported="false"
                 android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- The pocketed foot (bl-8bd0, DESIGN §18). Not exported: nothing
             outside this app may start it, and nothing needs to — the one
             starter is MainActivity's own resume, which is also the state the
             API 31+ background-start restriction exempts.

             `stopWithTask` is left at its default of false ON PURPOSE, and it
             is the attribute this whole rung turns on: swiping the app out of
             Recents destroys the Activity, and a foot that went with it would
             be absent exactly when the phone is pocketed. The host survives
             that because it belongs to the PROCESS (`crate::state`) rather
             than to the activity, and this service is what keeps the process
             from being frozen or evicted. -->
        <service android:name=".Pocket"
                 android:exported="false"
                 android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                      android:value="This device is enrolled as a remote tool host. The service holds one outbound mTLS connection to its operator's own engine so tool calls addressed to this phone are answered while it is in a pocket. No other foreground service type describes an inbound-work connection: dataSync is capped at six hours, and connectedDevice means a Bluetooth, NFC or USB companion." />
        </service>
    </application>
</manifest>
