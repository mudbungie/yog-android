<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: two generated layers and nothing of its own (bl-0b31).
     Both drawables are emitted from the mark's own walk by
     `yog_android::icon::drawable` and pinned byte-for-byte by its test, so
     the icon is a derivation with one source and this file is the wiring.

     `anydpi-v26` with no density fallback is exact rather than lazy:
     minSdk is 28, so every device this APK installs on understands an
     adaptive icon, and a PNG fallback would be a committed binary the
     disclosure gate refuses to read (AGENTS.md) for a device that cannot
     exist. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
