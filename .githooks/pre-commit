#!/usr/bin/env bash
# The gate is bl-gate (userconf), one copy for every repo on the machine; see
# AGENTS.md "The gate". Only the REF check lives here: no direct commits to
# mainline, a bl delivery squash (MERGE_MSG/SQUASH_MSG) excepted. Seated by
# `make install-hooks`. Bypass is intentionally not supported.

set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)"
git_dir="$(git rev-parse --git-dir)"

case "$branch" in
  main|master)
    if [ ! -f "$git_dir/MERGE_MSG" ] && [ ! -f "$git_dir/SQUASH_MSG" ]; then
      echo "error: direct commits to '$branch' are not permitted." >&2
      echo "       use 'bl claim <task>' to work in a worktree, then 'bl close'." >&2
      exit 1
    fi
    ;;
esac

exec bl-gate "$@"
